{
  "info": {
    "name": "SALEM API",
    "description": "Full API collection for SALEM backend.\n\n1. Set base_url (default: http://localhost:8000).\n2. Run Login → copy 'tokens.access' to access_token, 'tokens.refresh' to refresh_token.\n3. incident_id: use for detail/accept/change-status/image upload.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "incident_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Registration Metadata",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/registration-data/"
          }
        },
        {
          "name": "Sign Up (Citizen)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_type\": \"citizen\",\n  \"username\": \"testcitizen\",\n  \"email\": \"citizen@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"national_id\": \"12345678901234\",\n  \"phone_number\": \"01234567890\",\n  \"birth_date\": \"2000-01-01\"\n}"
            },
            "url": "{{base_url}}/signup/"
          }
        },
        {
          "name": "Sign Up (Employee)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_type\": \"employee\",\n  \"username\": \"testemployee\",\n  \"email\": \"employee@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"national_id\": \"98765432101234\",\n  \"department\": 1,\n  \"region\": 1,\n  \"role\": \"technician\"\n}"
            },
            "url": "{{base_url}}/signup/"
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{base_url}}/login/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/logout/"
          }
        },
        {
          "name": "Department List",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/departments/"
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "Incident Statuses",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/statuses/"
          }
        },
        {
          "name": "Incident List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/incidents/?search=&status=&assigned_to__employee_profile__department=&created_at__date__gte=&created_at__date__lte=&ordering=-created_at",
              "host": ["{{base_url}}"],
              "path": ["incidents", ""],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "", "description": "Status ID" },
                { "key": "assigned_to__employee_profile__department", "value": "", "description": "Department ID" },
                { "key": "created_at__date__gte", "value": "", "description": "YYYY-MM-DD" },
                { "key": "created_at__date__lte", "value": "", "description": "YYYY-MM-DD" },
                { "key": "ordering", "value": "-created_at", "description": "created_at or -created_at" }
              ]
            }
          }
        },
        {
          "name": "Incident Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/{{incident_id}}/"
          }
        },
        {
          "name": "Incident Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Street light broken\",\n  \"description\": \"The light at the corner is not working.\",\n  \"latitude\": \"31.200092\",\n  \"longitude\": \"29.918739\",\n  \"location\": \"Main Street, Block 5\",\n  \"status\": 1,\n  \"priority\": \"medium\"\n}"
            },
            "url": "{{base_url}}/incidents/create/"
          }
        },
        {
          "name": "My Incidents",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/my/"
          }
        },
        {
          "name": "Incident Image Upload",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "", "description": "Select image file" }
              ]
            },
            "url": "{{base_url}}/incidents/{{incident_id}}/images/"
          }
        },
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/dashboard/stats/"
          }
        },
        {
          "name": "Dashboard Weekly Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/dashboard/weekly/"
          }
        },
        {
          "name": "Dashboard Recent Incidents",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/dashboard/recent/"
          }
        },
        {
          "name": "Dashboard By Department",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/incidents/dashboard/by-department/"
          }
        },
        {
          "name": "Accept Incident",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{base_url}}/incidents/{{incident_id}}/accept/"
          }
        },
        {
          "name": "Change Incident Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": "{{base_url}}/incidents/{{incident_id}}/change-status/"
          }
        },
        {
          "name": "Incident History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/incidents/history/?street=&date=&priority=",
              "host": ["{{base_url}}"],
              "path": ["incidents", "history", ""],
              "query": [
                { "key": "street", "value": "" },
                { "key": "date", "value": "", "description": "YYYY-MM-DD" },
                { "key": "priority", "value": "", "description": "low | medium | high" }
              ]
            }
          }
        }
      ]
    }
  ]
}
